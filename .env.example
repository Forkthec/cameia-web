# Copiar a ".env" y completar con valores reales. ".env" nunca se versiona
# (ver .gitignore); este archivo de ejemplo sí, y por eso no lleva secretos.
#
# Todo lo de aquí se valida al arrancar en src/config/env.ts con zod: si falta
# una variable obligatoria, la app no arranca y el error dice cuál es.

VITE_APP_NAME=CAMEIA

# 'local' | 'staging' | 'production'. Producción exige VITE_API_BASE_URL.
VITE_APP_ENV=local

VITE_API_BASE_URL=http://localhost:8080

# Credenciales del proyecto de Firebase (Authentication). Se completan por
# entorno; nunca con valores reales en este archivo de ejemplo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Desarrollo local con el emulador de Firebase Auth (opcional) ---
# Con VITE_APP_ENV=local el cliente se conecta SIEMPRE al emulador (nunca en staging ni
# production). Requiere el docker compose de cameia-gateway (emulador en el puerto 9099).
# Para usarlo, reemplaza los VITE_FIREBASE_* de arriba por estos valores locales (ficticios;
# el emulador no valida la API key). VITE_FIREBASE_PROJECT_ID debe coincidir con
# FIREBASE_PROJECT_ID del gateway.
# VITE_FIREBASE_API_KEY=demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-cameia.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-cameia
# VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
#
# Host del emulador, formato host:puerto sin esquema. Opcional: si no se define, se usa localhost:9099.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# SIN EFECTO TODAVÍA: MSW no está cableado en el navegador (nadie importa
# src/mocks/browser.ts), así que esta variable no activa ningún mock. Los mocks
# solo se usan en las pruebas (Vitest). Ver README, "Trabajar sin backend".
VITE_ENABLE_MSW=true
