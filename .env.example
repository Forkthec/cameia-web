# Copiar a ".env" y completar con valores reales. ".env" nunca se versiona
# (ver .gitignore); este archivo de ejemplo sí, y por eso no lleva secretos.
#
# Todo lo de aquí se valida al arrancar en src/config/env.ts con zod: si falta
# una variable obligatoria, la app no arranca y el error dice cuál es.

VITE_APP_NAME=CAMEIA

# 'local' | 'staging' | 'production'. Entre otras cosas, decide si
# VITE_ENABLE_MSW tiene efecto (solo aplica cuando vale 'local').
VITE_APP_ENV=local

VITE_API_BASE_URL=http://localhost:8080

# Credenciales del proyecto de Firebase (Authentication). Se completan por
# entorno; nunca con valores reales en este archivo de ejemplo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Activa el mock de red (MSW). Solo tiene efecto si VITE_APP_ENV=local.
VITE_ENABLE_MSW=true
