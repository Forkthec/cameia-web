# Variables de entorno para `pnpm test` / `pnpm test:coverage` (Vitest usa
# `mode: 'test'` por defecto, así que Vite carga este archivo automáticamente
# — no hace falta configurarlo en ningún workflow de CI).
#
# Ninguno de estos valores es real ni secreto: ninguna prueba de este
# repositorio llama de verdad a un backend ni a Firebase (toda la red la
# intercepta MSW — `src/mocks/server.ts`, `src/test/setup.ts` — y la sesión
# de auth se simula manipulando `useAuthStore`, no el SDK). Solo necesitan
# tener la forma que exige `src/config/env.ts` para que la validación de
# arranque no falle. No copiar estos valores a `.env` real.
#
# Se versiona a propósito (ver excepción en .gitignore): sin este archivo,
# cualquier máquina sin un `.env` local propio —como el runner de CI— falla
# `pnpm test:coverage` en cuanto una prueba importa `httpClient`.

VITE_APP_NAME=CAMEIA
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_APP_ID=test-app-id
